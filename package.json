{
  "name": "orion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc --build && pnpm -r --if-present build:client",
    "clean": "tsc --build --clean && pnpm -r --if-present clean:client",
    "typecheck": "tsc --build --force",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm -r --parallel --if-present dev",
    "orion": "orion"
  },
  "devDependencies": {
    "@orion/cli": "workspace:*",
    "@orion/viewer": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
