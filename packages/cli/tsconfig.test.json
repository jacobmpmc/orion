{
  // Typechecks the tests, which the build config deliberately leaves out so
  // they never reach dist/. `composite` and `declaration` are off because a
  // composite project may not disable emit.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}
